# PostgreSQL do Supabase: copie a URL de Connect > Session pooler.
# Use sslmode=require e codifique caracteres especiais da senha na URL.
SUPABASE_DB_URL=

# Redis local ou URL do provedor (rediss:// para TLS quando disponível).
REDIS_URL=redis://localhost:6379/0
FLASK_SECRET_KEY=troque-por-uma-chave-aleatoria

# Alternativa para PostgreSQL local quando SUPABASE_DB_URL estiver vazia.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=aurora_vendas
